{
  "expo": {
    "name": "Documenta",
    "slug": "documenta-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "documenta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "4cf66cf9-0c53-4830-8a93-85e76b72178a"
      }
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8f7f3"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.documenta.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-dev-client",
      "expo-web-browser",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Documenta benötigt Kamerazugriff, um Dokumente zu scannen."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E57A5C",
          "defaultChannel": "documenta-local"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Documenta uses calendar access only after you confirm a calendar event.",
          "remindersPermission": "Documenta uses reminders only after your explicit confirmation."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
